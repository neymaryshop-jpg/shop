# Переменные окружения для Telegram бота
TELEGRAM_BOT_TOKEN=your_bot_token_here
DATABASE_URL=postgresql://user:password@localhost:5432/neymaryshop
SUPER_ADMIN_TELEGRAM_ID=your_telegram_id_here

# Пример:
# TELEGRAM_BOT_TOKEN=6234567890:AAH_example_token_here
# DATABASE_URL=postgresql://postgres:password@localhost:5432/neymaryshop
# SUPER_ADMIN_TELEGRAM_ID=123456789